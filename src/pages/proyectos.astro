---
import Layout from "../layouts/Layout.astro";
import Brand from "../components/home/shared/Brand.astro";
import NavLinks from "../components/home/shared/NavLinks.astro";
import SiteFooter from "../components/home/footer/SiteFooter.astro";
import { getProjects } from "../data/content";
import { socialProfiles } from "../data/home";

const baseUrl = import.meta.env.BASE_URL;
const projects = await getProjects(baseUrl);
const siteUrl = Astro.site ?? new URL("https://coheteria-beauchef.github.io");
const canonical = new URL(`${baseUrl}proyectos`, siteUrl).toString();
const ogImage = new URL(`${baseUrl}main_image.webp`, siteUrl).toString();

const navLinks = [
  { href: `${baseUrl}#nosotros`, label: "Nosotros" },
  { href: `${baseUrl}proyectos`, label: "Proyectos" },
  { href: `${baseUrl}equipo`, label: "Equipo" },
  { href: `${baseUrl}#sponsors`, label: "Sponsors" },
  { href: `${baseUrl}#prensa`, label: "Prensa" },
  { href: `${baseUrl}#contacto`, label: "Contacto" },
];
---

<Layout
  title="Proyectos | Cohetería Beauchef"
  description="Conoce los proyectos desarrollados por Cohetería Beauchef."
  canonical={canonical}
  ogImage={ogImage}
  socialLinks={Object.values(socialProfiles).map((href) => ({ href }))}
>
  <div class="flex min-h-screen flex-col bg-white">
    <nav class="sticky top-0 z-30 bg-[#1025B9] shadow-[0_18px_48px_rgba(16,37,185,0.24)]">
      <div class="flex h-20 items-center justify-between px-6 md:px-10 lg:px-16">
        <a href={baseUrl} aria-label="Volver al inicio">
          <Brand
            logoClass="w-10 h-10 object-contain shrink-0"
            textClass="text-white font-bold text-base sm:text-lg tracking-[2px]"
          />
        </a>
        <NavLinks
          links={navLinks}
          className="hidden md:flex items-center gap-6 lg:gap-10"
          linkClass="text-white/80 hover:text-white font-semibold text-base transition-colors duration-200"
        />
      </div>
    </nav>

    <main class="flex-1 px-6 py-20 sm:px-8 lg:px-16">
      <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-12">
        <header class="flex flex-col gap-4">
          <h1 class="text-4xl font-black leading-none text-[#1C1C1E] sm:text-5xl">
            Proyectos
          </h1>
          <p class="max-w-2xl text-lg leading-relaxed text-[#48484A]">
            Desarrollo experimental, diseño y pruebas del equipo.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {
            projects.length > 0 ? (
              projects.map((project) => (
                <article class="flex min-h-[260px] flex-col gap-6 rounded-lg border border-[#E5E5EA] bg-white p-6 shadow-sm">
                  <div class="flex items-start gap-4">
                    {project.logoSrc && (
                      <img
                        src={project.logoSrc}
                        alt=""
                        class="h-16 w-16 shrink-0 object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <div class="flex flex-col gap-2">
                      <h2 class="text-2xl font-black leading-tight text-[#1C1C1E]">
                        {project.title}
                      </h2>
                      <p class="leading-relaxed text-[#48484A]">{project.summary}</p>
                    </div>
                  </div>

                  {project.gallery.length > 0 && (
                    <div class="grid grid-cols-3 gap-3">
                      {project.gallery.slice(0, 3).map((src) => (
                        <img
                          src={src}
                          alt=""
                          class="aspect-video w-full rounded-md object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      ))}
                    </div>
                  )}

                  <div class="mt-auto flex flex-wrap gap-3 text-sm font-semibold text-[#1025B9]">
                    {project.videoUrl && <span>Video disponible</span>}
                    {project.model3dSrc && <span>Modelo 3D preparado</span>}
                  </div>
                </article>
              ))
            ) : (
              <p class="rounded-lg border border-dashed border-[#C7C7CC] p-8 text-[#48484A]">
                Los proyectos se publicarán cuando el equipo complete la información y los archivos.
              </p>
            )
          }
        </div>
      </div>
    </main>

    <SiteFooter />
  </div>
</Layout>
