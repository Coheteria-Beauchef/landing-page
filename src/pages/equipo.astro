---
import Layout from "../layouts/Layout.astro";
import Brand from "../components/home/shared/Brand.astro";
import NavLinks from "../components/home/shared/NavLinks.astro";
import TeamCard from "../components/home/shared/TeamCard.astro";
import TeamDialog from "../components/home/shared/TeamDialog.astro";
import SiteFooter from "../components/home/footer/SiteFooter.astro";
import { socialProfiles } from "../data/home";
import { getTeamAreas, getTeamPageSettings } from "../data/content";
import CtaSection from "../components/home/cta/CtaSection.astro";

const baseUrl = import.meta.env.BASE_URL;
const teamAreas = await getTeamAreas(baseUrl);
const teamPage = await getTeamPageSettings(baseUrl);

const navLinks = [
  { href: `${baseUrl}#nosotros`, label: "Nosotros" },
  { href: `${baseUrl}proyectos`, label: "Proyectos" },
  { href: `${baseUrl}equipo`, label: "Equipo" },
  { href: `${baseUrl}#sponsors`, label: "Sponsors" },
  { href: `${baseUrl}#prensa`, label: "Prensa" },
  { href: `${baseUrl}#contacto`, label: "Contacto" },
];
const siteUrl = Astro.site ?? new URL("https://coheteria-beauchef.github.io");
const canonical = new URL(`${baseUrl}equipo`, siteUrl).toString();
const ogImage = new URL(`${baseUrl}media/main_image.webp`, siteUrl).toString();

const captains = teamAreas.filter((entry) => entry.kind === "captain");
const leaders = teamAreas.filter((entry) => entry.kind === "area");
const workTeams = teamAreas.filter((entry) => entry.kind === "area" || entry.kind === "support");
const professors = teamAreas.filter((entry) => entry.kind === "professor");
const defaultTeamImageSrc = teamPage.defaultImageSrc;

const teamTitle = (role: string | string[]) => Array.isArray(role) ? role.at(-1) ?? role[0] : role;
const teamDialogId = (id: string | undefined, index: number) => `team-dialog-${id ?? index}`;
const teamDetails = (area: (typeof workTeams)[number]) => area.detailsMarkdown?.trim() || [
  `# ${teamTitle(area.lead.role)}`,
  area.description ?? teamPage.fallbackDescription,
  "",
  `## ${teamPage.membersHeading}`,
  ...(area.members.length > 0 ? area.members.map((member) => `- ${member}`) : [`- ${teamPage.fallbackMember}`]),
].join("\n");
---

<Layout
  title={teamPage.seoTitle}
  description={teamPage.seoDescription}
  canonical={canonical}
  ogImage={ogImage}
  socialLinks={Object.values(socialProfiles).map((href) => ({ href }))}
>
  <div class="flex min-h-screen flex-col bg-white">
    <nav class="sticky top-0 z-30" style="background: linear-gradient(180deg, rgba(16,37,185,0.94), rgba(16,37,185,0.9208)); box-shadow: 0 18px 48px rgba(16,37,185,0.28); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);" data-equipo-nav>
      <div class="flex h-20 items-center justify-between px-6 md:px-10 lg:px-16">
        <a href={baseUrl} aria-label="Volver al inicio">
          <Brand
            logoClass="w-10 h-10 object-contain shrink-0"
            textClass="text-white font-bold text-base sm:text-lg tracking-[2px]"
          />
        </a>
        <NavLinks
          links={navLinks}
          className="hidden md:flex items-center gap-6 lg:gap-10"
          linkClass="text-white/80 hover:text-white font-semibold text-base transition-colors duration-200"
        />
        <button
          class="flex md:hidden flex-col justify-center items-center w-10 h-10 gap-[5px]"
          data-hamburger
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300 origin-center" data-bar-1></span>
          <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300" data-bar-2></span>
          <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300 origin-center" data-bar-3></span>
        </button>
      </div>

      <div
        class="md:hidden overflow-hidden"
        style="max-height: 0; transition: max-height 0.3s ease;"
        data-mobile-menu
      >
        <div class="flex flex-col px-6 pb-4">
          {navLinks.map((link) => (
            <a href={link.href} class="py-3 text-white/90 hover:text-white font-semibold text-base border-b border-white/10 last:border-0 transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <script>
      const nav = document.querySelector("[data-equipo-nav]");
      const btn = nav?.querySelector("[data-hamburger]");
      const menu = nav?.querySelector("[data-mobile-menu]") as HTMLElement | null;
      const bar1 = btn?.querySelector("[data-bar-1]") as HTMLElement | null;
      const bar2 = btn?.querySelector("[data-bar-2]") as HTMLElement | null;
      const bar3 = btn?.querySelector("[data-bar-3]") as HTMLElement | null;

      let open = false;

      btn?.addEventListener("click", () => {
        open = !open;
        btn.setAttribute("aria-expanded", String(open));
        if (menu) menu.style.maxHeight = open ? `${menu.scrollHeight}px` : "0";
        if (bar1) bar1.style.transform = open ? "translateY(6.5px) rotate(45deg)" : "";
        if (bar2) bar2.style.opacity = open ? "0" : "1";
        if (bar3) bar3.style.transform = open ? "translateY(-6.5px) rotate(-45deg)" : "";
      });

      menu?.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", () => {
          open = false;
          btn?.setAttribute("aria-expanded", "false");
          if (menu) menu.style.maxHeight = "0";
          if (bar1) bar1.style.transform = "";
          if (bar2) bar2.style.opacity = "1";
          if (bar3) bar3.style.transform = "";
        });
      });
    </script>


    <script>
      const closeAnimationMs = 300;

      const setPageScrollLocked = (locked: boolean) => {
        document.documentElement.classList.toggle("overflow-hidden", locked);
        document.body.classList.toggle("overflow-hidden", locked);
      };

      const openTeamDialog = (dialog: HTMLElement) => {
        if (dialog.classList.contains("is-open")) return;

        dialog.classList.remove("is-closing");
        dialog.classList.add("is-visible");
        dialog.setAttribute("aria-hidden", "false");
        setPageScrollLocked(true);

        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            dialog.classList.add("is-open");
            dialog.querySelector<HTMLButtonElement>("[data-team-dialog-close]:not(.team-dialog__backdrop)")?.focus();
          });
        });
      };

      const closeTeamDialog = (dialog: HTMLElement) => {
        if (!dialog.classList.contains("is-open") || dialog.classList.contains("is-closing")) return;

        dialog.classList.remove("is-open");
        dialog.classList.add("is-closing");
        dialog.setAttribute("aria-hidden", "true");

        window.setTimeout(() => {
          dialog.classList.remove("is-visible", "is-closing");
          setPageScrollLocked(Boolean(document.querySelector("[data-team-dialog].is-open")));
        }, closeAnimationMs);
      };

      document.querySelectorAll<HTMLButtonElement>("[data-team-dialog-trigger]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const dialogId = trigger.dataset.teamDialogTrigger;
          if (!dialogId) return;

          const dialog = document.getElementById(dialogId);
          if (dialog) openTeamDialog(dialog);
        });
      });

      document.querySelectorAll<HTMLElement>("[data-team-dialog]").forEach((dialog) => {
        dialog.querySelectorAll<HTMLButtonElement>("[data-team-dialog-close]").forEach((button) => {
          button.addEventListener("click", () => closeTeamDialog(dialog));
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;

        const dialog = document.querySelector<HTMLElement>("[data-team-dialog].is-open");
        if (dialog) closeTeamDialog(dialog);
      });
    </script>

    <main class="flex-1 px-6 pt-20 pb-24 sm:px-8 lg:px-10">
      <div class="mx-auto max-w-[1440px]">
        <div class="mb-16 mt-12">
          <h1 class="text-4xl font-black leading-none tracking-[-0.04em] text-[#1C1C1E] sm:text-5xl">
            {teamPage.title}
          </h1>
        </div>

        <div class="flex flex-col items-center gap-16">
          <section class="flex w-full flex-col items-center gap-10">
            <div class="flex flex-col items-center gap-3 text-center">
              <h3 class="text-2xl font-black leading-tight tracking-[-0.03em] text-[#1025B9] underline decoration-[#1025B9]/30 decoration-2 underline-offset-8 sm:text-3xl">
                {teamPage.studentOrgTitle}
              </h3>
            </div>

            <div class="flex w-full max-w-6xl flex-col items-center gap-10 py-2">
              <div class="grid w-full max-w-[620px] grid-cols-1 justify-items-center gap-6 sm:grid-cols-2">
                {captains.map((captain) => (
                  <TeamCard {...captain.lead} />
                ))}
              </div>

              <div class="grid w-full grid-cols-1 justify-items-center gap-6 sm:grid-cols-2 lg:grid-cols-4">
                {leaders.map((leader) => (
                  <TeamCard {...leader.lead} />
                ))}
              </div>
            </div>
          </section>

          {professors.length > 0 && (
            <section class="flex w-full flex-col items-center gap-8">
              <div class="flex flex-col items-center gap-3 text-center">
                <h3 class="text-2xl font-black leading-tight tracking-[-0.03em] text-[#1025B9] underline decoration-[#1025B9]/30 decoration-2 underline-offset-8 sm:text-3xl">
                  {teamPage.professorsTitle}
                </h3>
              </div>

              <div class="flex flex-wrap justify-center gap-6">
                {professors.map((professor) => (
                  <TeamCard
                    {...professor.lead}
                    imageSrc={professor.lead.imageSrc ?? defaultTeamImageSrc}
                    imageAlt={professor.lead.imageAlt ?? teamPage.defaultImageAlt}
                    members={professor.members}
                  />
                ))}
              </div>
            </section>
          )}

          <section class="flex w-full flex-col items-center gap-8">
            <div class="flex flex-col items-center gap-3 text-center">
              <h3 class="text-2xl font-black leading-tight tracking-[-0.03em] text-[#1025B9] underline decoration-[#1025B9]/30 decoration-2 underline-offset-8 sm:text-3xl">
                {teamPage.workTeamsTitle}
              </h3>
            </div>

            <div class="flex w-full max-w-6xl flex-wrap justify-center gap-6">
              {workTeams.map((area, index) => (
                <TeamCard
                  name={teamTitle(area.lead.role)}
                  imageSrc={area.coverImageSrc ?? defaultTeamImageSrc}
                  imageAlt={area.coverImageAlt ?? teamPage.defaultImageAlt}
                  members={area.members}
                  dialogId={teamDialogId(area.id, index)}
                />
              ))}
            </div>

            {workTeams.map((area, index) => (
              <TeamDialog
                id={teamDialogId(area.id, index)}
                title={teamTitle(area.lead.role)}
                imageSrc={area.coverImageSrc ?? defaultTeamImageSrc}
                imageAlt={area.coverImageAlt ?? teamPage.defaultImageAlt}
                markdown={teamDetails(area)}
              />
            ))}
          </section>
        </div>
      </div>
    </main>

    {teamPage.showCta && <CtaSection showTeamLink={false} />}

    <SiteFooter />
  </div>
</Layout>
