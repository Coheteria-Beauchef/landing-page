---
interface Props {
  url: string;
  excerpt: string;
  likes: number;
  comments: number;
  imageSrc: string;
  imageAlt: string;
}

const { url, excerpt, likes, comments, imageSrc, imageAlt } = Astro.props as Props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex w-full flex-col overflow-hidden rounded-sm border border-[#E5E7EB] bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1025B9]"
>
  <div class="p-5 flex flex-col gap-3 h-[160px]">
    <p class="text-[#48484A] font-normal text-sm leading-relaxed line-clamp-4 whitespace-pre-line">
      {excerpt}
    </p>
    <div class="flex items-center gap-4 mt-auto">
      <span class="text-[#111118] font-normal text-sm">♡ {likes}</span>
      <span class="text-[#111118] font-normal text-sm">💬 {comments}</span>
    </div>
  </div>
  <div class="relative aspect-square w-full overflow-hidden md:aspect-[4/5]">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full scale-[1.08] object-cover object-center md:scale-100"
    />
  </div>
</a>
