---
import { headerNavigationLinks } from "../../../data/home";
import ActionButton from "../shared/ActionButton.astro";
import Brand from "../shared/Brand.astro";
import NavLinks from "../shared/NavLinks.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<section
  id="top"
  class="hero-section relative w-full bg-[#0A0A0A] overflow-hidden md:aspect-[3375/2157]"
  style="height: calc(100svh + var(--home-announcement-height, 0px)); min-height: calc(720px + var(--home-announcement-height, 0px));"
  data-home-hero
>
  <img
    src={`${baseUrl}main-image2.webp`}
    alt="Equipo de Cohetería Beauchef"
    width="3375"
    height="2157"
    loading="eager"
    decoding="sync"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-[center_18%] opacity-85 md:object-contain md:object-top"
  />

  <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#1024b0e6] to-[#1025B9E6] opacity-45"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_10%,rgb(10_10_10_/_0.18)_55%,rgb(10_10_10_/_0.56)_100%)]"></div>

  <nav
    data-home-nav
    class="site-nav animate-nav-in fixed inset-x-0 z-30 transition-all duration-300 ease-out"
    style="top: var(--home-announcement-height, 0px);"
  >
    <div class="flex h-20 items-center justify-between px-6 md:px-10 lg:px-16">
      <a href={`${baseUrl}#top`} aria-label="Volver al inicio" class="relative z-10 p-1">
        <Brand logoClass="h-[5.5125rem] w-[11.025rem] object-contain shrink-0" />
      </a>
      <NavLinks
        links={headerNavigationLinks}
        className="hidden md:flex items-center gap-6 lg:gap-10"
        linkClass="home-nav-link text-white font-semibold text-base transition-colors duration-300"
      />
      <button
        class="relative z-10 flex md:hidden flex-col justify-center items-center w-10 h-10 gap-[5px]"
        data-hamburger
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300 origin-center" data-bar-1></span>
        <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300" data-bar-2></span>
        <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300 origin-center" data-bar-3></span>
      </button>
    </div>

    <div
      class="mobile-menu md:hidden overflow-hidden"
      style="max-height: 0; transition: max-height 0.3s ease;"
      data-mobile-menu
    >
      <div class="flex flex-col px-6 pb-4">
        {headerNavigationLinks.map((link) => (
          <a href={link.href} class="py-3 text-white font-semibold text-base border-b border-white/10 last:border-0">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <div
    class="absolute inset-x-0 top-0 bottom-0 z-10 flex flex-col items-center justify-between gap-6 px-6 pb-10 pt-[calc(7rem+var(--home-announcement-height,0rem))] text-center md:inset-0 md:mb-0 md:items-center md:justify-end md:px-10 md:pb-0 md:pt-0 md:text-center lg:px-16"
  >
    <h1 class="animate-hero-in [animation-delay:140ms] mt-4 flex w-full max-w-7xl flex-wrap justify-center gap-x-6 text-center text-white font-bold text-6xl sm:text-7xl lg:text-8xl xl:text-9xl leading-none tracking-tighter [animation-fill-mode:both] md:absolute md:left-1/2 md:top-[18%] md:mt-0 md:w-full md:-translate-x-1/2 md:-translate-y-1/2 md:justify-center md:text-center">
      <span>Cohetería</span>
      <span>Beauchef</span>
    </h1>
    <div class="contents w-full md:absolute md:inset-x-0 md:top-[60%] md:flex md:flex-col md:items-center md:gap-6">
      <p class="animate-hero-in [animation-delay:260ms] mt-auto max-w-3xl text-[#FFFFFFEE] font-normal text-lg sm:text-xl lg:text-2xl leading-relaxed tracking-[-0.5px] [animation-fill-mode:both] md:mt-0">
        Equipo de coheter&iacute;a experimental,<br />
        impulsamos la ingenier&iacute;a y tecnolog&iacute;a aeroespacial.
      </p>
      <div class="animate-hero-in [animation-delay:380ms] mt-2 flex flex-col items-center gap-4 sm:flex-row [animation-fill-mode:both] md:mt-0">
        <ActionButton href="https://docs.google.com/forms/d/1vyjHI6xVyBgM_vzmK09dA2AxAkPrcnCyfVkX4mjg6kw/viewform?pli&pli&edit_requested=true" label="Únete al Equipo" />
        <ActionButton href="#proyectos" label="Conócenos" variant="secondary" />
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .hero-section {
      height: auto !important;
      min-height: 0 !important;
    }
  }

  .site-nav {
    background: transparent;
  }

  .site-nav .home-nav-link {
    color: white;
  }

  .site-nav .home-nav-link:hover {
    color: rgb(226 232 240);
  }

  .site-nav.is-scrolled .home-nav-link:hover {
    color: rgb(191 219 254);
  }

  @media (min-width: 768px) {
    .site-nav {
      background: linear-gradient(180deg, rgba(16, 37, 185, 0.94), rgba(16, 37, 185, 0.9208)) !important;
      box-shadow: 0 18px 48px rgba(16, 37, 185, 0.28) !important;
      backdrop-filter: blur(18px) !important;
      -webkit-backdrop-filter: blur(18px) !important;
    }
  }

  @keyframes nav-in {
    0% {
      opacity: 0;
      transform: translateY(-18px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-in {
    0% {
      opacity: 0;
      transform: translateY(28px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-nav-in {
    animation: nav-in 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .animate-hero-in {
    animation: hero-in 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-nav-in,
    .animate-hero-in {
      animation: none;
    }
  }
</style>

<script>
  import { initHeroSection } from "./initHeroSection";

  initHeroSection();
</script>
