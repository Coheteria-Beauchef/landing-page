---
interface Props {
  className?: string;
  logoClass?: string;
}

const {
  className = "",
  logoClass = "h-24 w-48 object-contain",
} = Astro.props as Props;

const baseUrl = import.meta.env.BASE_URL;
---

<div class:list={["flex min-w-0 items-center gap-3", className]}>
  <img
    src={`${baseUrl}logos/logo_with_text.svg`}
    alt="Logo Cohetería Beauchef"
    class={logoClass}
  />
</div>
